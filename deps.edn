{:paths ["src" "resources"]

 ;; Unpublished siblings resolve through the untracked local.deps.edn:
 ;;   clojure -Sdeps "$(cat local.deps.edn)" -M:test
 :deps {org.clojure/clojure {:mvn/version "1.12.5"}
        io.github.hive-agi/hive-addon {:mvn/version "1.0.3"}
        io.github.hive-agi/hive-vessel {:mvn/version "0.1.0"}}

 :aliases
 {:dev  {:extra-paths ["dev" "test"]}

  :test {:extra-paths ["test"]
         :extra-deps  {io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}

  :build {:deps {io.github.hive-agi/hive-build {:mvn/version "0.1.12"}}
          :ns-default hive-build.api}}}
