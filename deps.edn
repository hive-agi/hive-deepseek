{:paths ["src" "resources"]

 ;; To develop against sibling checkouts, use the untracked local.deps.edn:
 ;;   clojure -Sdeps "$(cat local.deps.edn)" -M:test
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        io.github.hive-agi/hive-addon {:mvn/version "1.0.10"}
        io.github.hive-agi/hive-vessel {:mvn/version "0.1.4"}
        io.github.hive-agi/hive-spi {:mvn/version "1.1.1"}}

 :aliases
 {:dev  {:extra-paths ["dev" "test"]}

  :test {:extra-paths ["test"]
         :extra-deps  {io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                       io.github.hive-agi/hive-test {:mvn/version "0.4.5"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}

  :build {:deps {io.github.hive-agi/hive-build {:mvn/version "0.1.17"}}
          :jvm-opts ["-Xmx1g"]
          :ns-default hive-build.api}}}
